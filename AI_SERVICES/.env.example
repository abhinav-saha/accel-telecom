# Copy this file to .env and fill in ONE free key. The app also works with no key (rules + local OCR mode).

# Option 1 (recommended): Google Gemini free tier - chat + document reading (vision)
# Get a key in 1 minute: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Option 2: Groq free tier (OpenAI-compatible) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# KYC documents are read locally by default (works offline, images never leave this machine).
# Set to true to read them with the LLM vision model instead (uses more free-tier quota).
KYC_USE_LLM=false

# Back-office PIN (demo)
ADMIN_PIN=2026
